{
  "manifest_version": 3,
  "name": "Tab Suspender Lite",
  "version": "0.1.0",
  "description": "极简的标签页冻结扩展：把暂时不用的标签页换成轻量占位页，点击即可恢复。",
  "minimum_chrome_version": "102",
  "permissions": ["tabs", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "suspend-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "冻结当前标签页"
    },
    "suspend-other-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "冻结当前窗口内除当前页外的所有标签页"
    }
  }
}
